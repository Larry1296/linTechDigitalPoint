SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=http://localhost:5173

DB_NAME=lintech_digital_point
DB_USER=lintech
DB_PASSWORD=replace-with-a-local-password
DB_HOST=localhost
DB_PORT=5432

FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=LinTech Digital Point <noreply@lintech.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

COOKIE_SECURE=False

# M-Pesa / Daraja (server-side only)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=

# AI assistants (server-side only; never commit real keys)
# Claude powers the public help chat on the home page and, by default, each business's assistant.
# Get a key at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
# Optional: ChatGPT as a second choice owners can pick for their business assistant.
OPENAI_API_KEY=
BUSINESS_ASSISTANT_PROVIDER=anthropic
BUSINESS_ASSISTANT_ANTHROPIC_MODEL=claude-opus-5-5
BUSINESS_ASSISTANT_OPENAI_MODEL=gpt-5.5
BUSINESS_ASSISTANT_EFFORT=medium
# Looks up money market fund rates (CIC) every 10 days with the same Claude key.
FUND_RATE_MODEL=claude-opus-5-5
PLATFORM_NAME=LinTech Digital Point
PLATFORM_CONTACT_EMAIL=

# Production settings: copy to /opt/lintech/.env on the server and fill in. Never commit the real file.
# Make each secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- The site -----------------------------------------------------------------------------------------------------
# The domain whose DNS A record points at the Droplet. Use :80 for a first look on the server's IP before DNS is ready
# (plain http: logging in will not work until HTTPS is on, because cookies are secure-only).
SITE_DOMAIN=app.example.co.ke
PLATFORM_NAME=DukaFlow
PLATFORM_CONTACT_EMAIL=support@example.co.ke

# --- Set by the deploy workflow (leave as they are) ---------------------------------------------------------------
IMAGE_PREFIX=ghcr.io/larry1296/lintechdigitalpoint
IMAGE_TAG=latest

# --- Security -----------------------------------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
# Encrypts each business's saved M-Pesa (Daraja) keys. Make it once with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and never change it, or businesses must enter their M-Pesa keys again.
FIELD_ENCRYPTION_KEY=replace-with-a-fernet-key
COOKIE_SECURE=True
# Browsers then only ever use https for the site. Start smaller (3600) and raise once all is well.
SECURE_HSTS_SECONDS=31536000

# --- Database (the db container) ----------------------------------------------------------------------------------
DB_NAME=lintech
DB_USER=lintech
DB_PASSWORD=replace-with-a-long-random-password

# --- Email (password resets, emailed receipts) ---------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=DukaFlow <noreply@example.co.ke>

# --- AI assistants --------------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BUSINESS_ASSISTANT_PROVIDER=anthropic

# --- Subscriptions paid by M-Pesa (the platform's own till or paybill) -------------------------------------------------
# off until the Daraja app is live; then production. Callbacks go to https://SITE_DOMAIN automatically.
MPESA_MODE=off
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PARTY_B=
MPESA_CALLBACK_TOKEN=replace-with-a-long-random-secret

# --- Tuning (optional) ----------------------------------------------------------------------------------------------
GUNICORN_WORKERS=2
GUNICORN_THREADS=8
LOG_LEVEL=INFO
